# The one public origin. No port and no path: which lobby we talk to is decided
# at runtime from the channel the extension is loaded on, and routed as
# /l/<channelId>/socket.io. This is the only domain that needs allowlisting in
# the Twitch developer console (plus cdn.onestreamrpg.com and api.twitch.tv).
VITE_API_BASE=https://onestreamrpg.pauledevelopment.com

VITE_DEVELOPER=true
# Set to "true" to render the UI with no backend at all. Anything else = normal.
VITE_DISABLE_BACKEND=false

VITE_DEBUG_WORLD_INTERACTION=true
